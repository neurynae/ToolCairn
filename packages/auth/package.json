{
  "name": "@toolpilot/auth",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "default": "./dist/config.js"
    },
    "./password": {
      "types": "./dist/password.d.ts",
      "default": "./dist/password.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "next-auth": "^5.0.0-beta.29",
    "@auth/prisma-adapter": "^2.8.0",
    "bcryptjs": "^3.0.2",
    "jose": "^5.10.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@toolpilot/tsconfig": "workspace:*",
    "@toolpilot/db": "workspace:*",
    "@types/bcryptjs": "^2.4.6",
    "typescript": "^5.7.2",
    "rimraf": "^6.0.1"
  },
  "peerDependencies": {
    "next": ">=15.0.0"
  }
}
