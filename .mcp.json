{
  "mcpServers": {
    "toolpilot": {
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "@neurynae/toolcairn-mcp@latest"
      ],
      "env": {
        "TOOLPILOT_API_URL": "https://api.neurynae.com",
        "LOG_LEVEL": "warn"
      }
    },
    "github": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "-e",
        "GITHUB_PERSONAL_ACCESS_TOKEN",
        "ghcr.io/github/github-mcp-server"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_PERSONAL_ACCESS_TOKEN}"
      }
    },
    "playwright": {
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "@playwright/mcp@latest",
        "--browser",
        "chromium",
        "--isolated"
      ]
    },
    "context7": {
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "@upstash/context7-mcp@latest"
      ]
    },
    "memgraph": {
      "command": "docker",
      "args": [
        "run",
        "--rm",
        "-i",
        "-e",
        "MCP_TRANSPORT=stdio",
        "-e",
        "MEMGRAPH_URL=bolt://host.docker.internal:7687",
        "-e",
        "MCP_READ_ONLY=false",
        "mcp-memgraph:latest"
      ]
    },
    "qdrant": {
      "command": "cmd",
      "args": [
        "/c",
        "uvx",
        "mcp-server-qdrant"
      ],
      "env": {
        "QDRANT_URL": "http://localhost:6333",
        "COLLECTION_NAME": "tools"
      }
    },
    "postgres": {
      "command": "mcp-server-postgres",
      "args": [
        "postgresql://toolpilot:toolpilot@localhost:5432/toolpilot"
      ]
    },
    "redis": {
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "@modelcontextprotocol/server-redis",
        "redis://localhost:6379"
      ]
    },
    "prisma": {
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "mcp-remote",
        "https://mcp.prisma.io/mcp"
      ]
    },
    "vercel": {
      "type": "http",
      "url": "https://mcp.vercel.com"
    }
  }
}