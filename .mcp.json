{
  "mcpServers": {
    "toolpilot": {
      "command": "node",
      "args": [
        "D:\\ToolPilot\\apps\\mcp-server\\dist\\index.js"
      ],
      "env": {
        "MEMGRAPH_URL": "bolt://localhost:7687",
        "MEMGRAPH_USER": "",
        "MEMGRAPH_PASSWORD": "",
        "QDRANT_URL": "http://localhost:6333",
        "DATABASE_URL": "postgresql://toolpilot:toolpilot@localhost:5432/toolpilot",
        "REDIS_URL": "redis://localhost:6379",
        "NODE_ENV": "development",
        "LOG_LEVEL": "warn",
        "NOMIC_API_KEY": "nk-9laqiAMi4tzfzppuswfvMootrxIZJYHICGG9wXi43U4"
      }
    },
    "github": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "-e",
        "GITHUB_PERSONAL_ACCESS_TOKEN",
        "ghcr.io/github/github-mcp-server"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_PERSONAL_ACCESS_TOKEN}"
      }
    },
    "playwright": {
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "@playwright/mcp@latest",
        "--browser",
        "chromium"
      ]
    },
    "context7": {
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "@upstash/context7-mcp@latest"
      ]
    },
    "memgraph": {
      "command": "docker",
      "args": [
        "run",
        "--rm",
        "-i",
        "-e",
        "MCP_TRANSPORT=stdio",
        "-e",
        "MEMGRAPH_URL=bolt://host.docker.internal:7687",
        "-e",
        "MCP_READ_ONLY=false",
        "mcp-memgraph:latest"
      ]
    },
    "qdrant": {
      "command": "cmd",
      "args": [
        "/c",
        "uvx",
        "mcp-server-qdrant"
      ],
      "env": {
        "QDRANT_URL": "http://localhost:6333",
        "COLLECTION_NAME": "tools"
      }
    },
    "postgres": {
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "@modelcontextprotocol/server-postgres",
        "postgresql://toolpilot:toolpilot@localhost:5432/toolpilot"
      ]
    }
  }
}